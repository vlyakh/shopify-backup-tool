generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify app sessions (required by Shopify App Remix)
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Store settings and subscription info
model Store {
  id        String   @id // shop domain e.g. "my-store.myshopify.com"
  plan      Plan     @default(FREE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Backup settings
  autoBackupEnabled Boolean @default(false)
  autoBackupHour    Int     @default(3) // UTC hour for daily backup
  retentionDays     Int     @default(7)

  // A staged *shrink* of retentionDays, from a downgrade or a lapsed
  // subscription. Applying a smaller window immediately would let the hourly
  // retention sweep permanently delete history the merchant may still want,
  // on paths they never confirmed (lapsed trial, declined card, cancellation
  // from Shopify's own billing UI). So the larger window stays in force and
  // the scheduler applies this once pendingRetentionAt passes. Re-subscribing
  // clears both fields. See RETENTION_GRACE_DAYS in app/billing.ts.
  pendingRetentionDays Int?
  pendingRetentionAt   DateTime?

  // When this shop first held an active PAID subscription. Shopify applies
  // trialDays per subscription and never tracks whether a shop already had a
  // trial, so without this a merchant could switch plans (or cancel and
  // resubscribe) to collect a fresh free trial indefinitely. Once set, the
  // shop is offered the no-trial plan variants.
  trialUsedAt DateTime?

  // Webhook settings (premium tier)
  webhooksEnabled Boolean @default(false)

  // Set on app/uninstalled; used for re-baselining on reinstall
  uninstalledAt DateTime?

  // Last successful OAuth/token exchange (afterAuth). Lets the
  // app/uninstalled handler ignore late at-least-once deliveries that fired
  // BEFORE a reinstall — otherwise a retried uninstall webhook would disable
  // a live install and arm the 30-day purge.
  lastAuthAt DateTime?

  backups         Backup[]
  backupSchedules BackupSchedule[]
}

enum Plan {
  FREE
  STANDARD
  PREMIUM
}

// A single backup snapshot
model Backup {
  id        String       @id @default(cuid())
  storeId   String
  store     Store        @relation(fields: [storeId], references: [id])
  status    BackupStatus @default(PENDING)
  trigger   BackupTrigger
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Summary stats
  productCount    Int @default(0)
  variantCount    Int @default(0)
  collectionCount Int @default(0)
  pageCount       Int @default(0)
  blogPostCount   Int @default(0)
  redirectCount   Int @default(0)

  // Live progress: number of items saved so far (updated while IN_PROGRESS)
  processedCount  Int @default(0)

  // Storage location (S3/Azure Blob path)
  storagePath String?
  sizeBytes   BigInt  @default(0)

  // Error info
  errorMessage String?

  items BackupItem[]

  @@index([storeId, createdAt])
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum BackupTrigger {
  MANUAL
  SCHEDULED
  WEBHOOK
}

// Individual backed-up resources within a backup
model BackupItem {
  id         String         @id @default(cuid())
  backupId   String
  backup     Backup         @relation(fields: [backupId], references: [id], onDelete: Cascade)
  resourceType ResourceType
  resourceId   String       // Shopify resource GID or numeric ID
  title        String?      // Human-readable name
  dataHash     String       // Hash of the JSON data for change detection
  storagePath  String       // Path to the JSON blob in storage

  @@index([backupId, resourceType])
  @@index([resourceId])
}

enum ResourceType {
  PRODUCT
  COLLECTION
  PAGE
  BLOG_POST
  REDIRECT
  THEME
  MENU
  POLICY
  METAOBJECT
}

enum BackupInterval {
  EVERY_6H
  EVERY_12H
  DAILY
  WEEKLY
}

// Schedule configuration for auto-backups
model BackupSchedule {
  id        String         @id @default(cuid())
  storeId   String
  store     Store          @relation(fields: [storeId], references: [id])
  enabled   Boolean        @default(true)
  interval  BackupInterval @default(DAILY)
  cronExpr  String         @default("0 3 * * *") // Daily at 3 AM UTC
  lastRunAt DateTime?
  nextRunAt DateTime?
  // UTC weekday (0=Sun..6=Sat) a WEEKLY schedule fires on. Stored explicitly
  // because the scheduler's failure path reuses nextRunAt as an hourly retry
  // timer, so nextRunAt's weekday can't be trusted as the anchor.
  weeklyDay Int?

  @@unique([storeId])
}

// Change log for premium tier (webhook-driven)
model ChangeLog {
  id           String       @id @default(cuid())
  storeId      String
  resourceType ResourceType
  resourceId   String
  action       ChangeAction
  changedAt    DateTime     @default(now())

  // Before/after snapshots stored in blob storage
  beforePath String?
  afterPath  String?

  // Summary of what changed
  changedFields String[] // e.g. ["title", "price", "variants[0].price"]

  // Revert-generated event (our own write's webhook echo, or an event undone by
  // "Revert all to backup"). Recorded so the diff baseline advances, but hidden
  // from the merchant-facing history.
  hidden Boolean @default(false)

  // Field tokens of edits the merchant has undone via per-field Undo
  // (e.g. ["title", "variant:price:gid://shopify/ProductVariant/123"])
  undoneFields String[] @default([])

  // WebhookEvent that produced this entry (idempotency key for retries)
  webhookEventId String?

  @@index([storeId, changedAt])
  @@index([storeId, resourceType])
  @@index([storeId, resourceId])
  @@index([webhookEventId])
}

enum ChangeAction {
  CREATED
  UPDATED
  DELETED
}

// Marks that the next products/update webhook(s) for a product are echoes of
// our own revert writes and should be recorded hidden. Replaces what used to be
// process-local memory (lost on every redeploy, broken with >1 instance).
model RevertSuppression {
  storeId    String
  resourceId String // product GID

  // "Hide the next N webhooks" marks (per-field undo); valid until countExpiresAt
  count          Int       @default(0)
  countExpiresAt DateTime?

  // "Hide ALL webhooks until this time" burst window (revert-all / metafields)
  windowUntil DateTime?

  // When the current mark (count or window) was armed
  armedAt DateTime?

  updatedAt DateTime @updatedAt

  @@id([storeId, resourceId])
}

// Webhook intake queue — accepts events fast, processes in background
model WebhookEvent {
  id           String        @id @default(cuid())
  storeId      String
  topic        String        // e.g. "products/update", "collections/create"
  webhookId    String?       @unique // Shopify X-Shopify-Webhook-Id, for redelivery dedup
  resourceType ResourceType
  resourceId   String
  action       ChangeAction
  payload      String        // Raw JSON payload from Shopify (stored as text)
  status       WebhookStatus @default(PENDING)
  attempts     Int           @default(0)
  lastError    String?
  createdAt    DateTime      @default(now())
  claimedAt    DateTime?     // set when a processor tick claims the row
  processedAt  DateTime?

  @@index([status, createdAt])
  @@index([storeId])
}

enum WebhookStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED    // DLQ — moved here after max retries
  SKIPPED   // Inventory-only change, not worth recording
}
